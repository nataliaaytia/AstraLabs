            },
            "description": "Guarda el token en {{token}}. Los demás requests lo usan automáticamente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
