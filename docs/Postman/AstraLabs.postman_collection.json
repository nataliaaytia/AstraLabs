{
  "info": {
    "name": "AstraLabs — API Inventario (Casa Amandita del Adulto Mayor)",
    "description": "Colección para probar el backend de Inventario. Haz login (carpeta Auth) con el rol deseado: el token se guarda en {{token}} y se envía solo en cada request. Incluye filtros de listados, entradas, lotes, donantes, menús, planes de comida, reportes y exportaciones a Excel/PDF.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "articulo_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "categoria_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "usuario_id",
      "value": "2",
      "type": "string"
    },
    {
      "key": "donante_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "menu_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "plan_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Administradora",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@amandita.test\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Guarda el token en {{token}}. Los demás requests lo usan automáticamente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "if (d.token) { pm.collectionVariables.set('token', d.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Recepcion",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/auth/login",
